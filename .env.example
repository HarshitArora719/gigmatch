# ====================================================
# GigMatch Root Environment Variables Template
# ====================================================

# Backend Configuration (server/.env)
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gigmatch?retryWrites=true&w=majority
JWT_SECRET=generate_a_secure_random_64_char_secret_key_here
JWT_EXPIRE=7d
CLIENT_URL=https://gigmatch.vercel.app

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Configuration (client/.env)
VITE_API_URL=https://gigmatch-api.onrender.com