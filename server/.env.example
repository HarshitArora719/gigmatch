# ====================================================
# GigMatch Server Environment Configuration
# ====================================================

NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gigmatch?retryWrites=true&w=majority
JWT_SECRET=super_long_random_secret_key_here_2026
JWT_EXPIRE=7d
CLIENT_URL=https://gigmatch.vercel.app

# Cloudinary (Required for portfolio & deliverable uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
